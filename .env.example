# Google Gemini AI Key
GEMINI_API_KEY=

# Server Environment
PORT=3000
NODE_ENV=development
JWT_SECRET=

# Database (PostgreSQL / Cloud SQL)
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
DATABASE_PROVIDER=file

# Storage & Data Isolation (APPLICATION CODE != USER DATA)
# Mount path for persistent storage (e.g. /shared, /var/data/caffeine, ./shared)
STORAGE_ROOT=
CAFFEINE_STORAGE_DIR=
DATA_DIR=
UPLOADS_DIR=
LOGS_DIR=
BACKUPS_DIR=
SECRETS_DIR=

# SMS Gateway (Kavenegar / FarazSMS / MeliPayamak)
SMS_API_KEY=
SMS_SENDER_NUMBER=

# Email SMTP Gateway
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fast-Creat Timezone Web Service
FAST_CREAT_API_KEY=
