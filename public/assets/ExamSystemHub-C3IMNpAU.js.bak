    }
  } else if (/(?:^|\n)\s*(?:={3,}|-{3,}|_{3,})\s*(?:تست|سوال|مسئله)?\s*(?:[0-9۰-۹]+)?\s*(?:={3,}|-{3,}|_{3,})?/i.test(text)) {
    chunks = text.split(/(?:^|\n)\s*(?:={3,}|-{3,}|_{3,})\s*(?:تست|سوال|مسئله)?\s*(?:[0-9۰-۹]+)?\s*(?:={3,}|-{3,}|_{3,})?/i).map(c => c.trim()).filter(c => c.length > 10);
  } else if (/(?:^|\n)\s*(?:تست|سوال|مسئله|Question)\s*(?:[0-9۰-۹]{1,4})\s*[:.-]/i.test(text)) {
    chunks = text.split(/(?:^|\n)(?=\s*(?:تست|سوال|مسئله|Question)\s*(?:[0-9۰-۹]{1,4})\s*[:.-])/i).map(c => c.trim()).filter(c => c.length > 10);
  } else if (/(?:^|\n)\s*(?:[0-9۰-۹]{1,4})\s*[-:]\s+/i.test(text)) {
