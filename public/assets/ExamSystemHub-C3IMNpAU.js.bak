  if (!rawText || typeof rawText !== "string") return [];
  const text = rawText.replace(/\r\n/g, "\n").replace(/\r/g, "\n").trim();
  if (!text) return [];

  const faDigits = {
    "۱": 1, "۲": 2, "۳": 3, "۴": 4,
    "1": 1, "2": 2, "3": 3, "4": 4,
    "الف": 1, "ب": 2, "ج": 3, "د": 4,
    "A": 1, "B": 2, "C": 3, "D": 4,
    "a": 1, "b": 2, "c": 3, "d": 4
