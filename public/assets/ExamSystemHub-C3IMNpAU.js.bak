  const dupSet = new Set(existing.map(q => (q.questionText || "").trim().replace(/\s+/g, " ")));

  // JSON detection
  if ((text.startsWith("[") && text.endsWith("]")) || (text.startsWith("{") && text.endsWith("}"))) {
