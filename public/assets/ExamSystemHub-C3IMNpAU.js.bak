  if (sub.includes("ریاضی")) {
    sample = "=== تست ۱ ===\nسوال: اگر تابع $f(x) = x^3 - 3x^2 + 4$ در بازه $[0, 3]$ تعریف شده باشد، مجموع مقادیر ماکزیمم مطلق و مینیمم مطلق آن کدام است؟\n۱) ۴\n۲) ۶\n۳) ۸\n۴) ۱۰\nپاسخ: گزینه ۱\nپاسخ تشریحی:\nمشتق تابع برابر $f\x27(x) = 3x^2 - 6x = 3x(x - 2)$ است. ریشه‌ها $x = 0$ و $x = 2$ هستند. مقادیر تابع: $f(0) = 4$، $f(2) = 0$، $f(3) = 4$. بنابراین ماکزیمم مطلق ۴ و مینیمم مطلق ۰ است و مجموع برابر ۴ است.\nدرس: ریاضی تجربی | فصل: فصل پنجم: کاربرد مشتق | مبحث: درس ۴: اکسترمم‌های مطلق | پایه: جامع | رشته: تجربی | سختی: متوسط | منبع: کنکور سراسری\n\n=== تست ۲ ===\nسوال: حاصل حد $\\lim_{x \\to 2} \\frac{x^2 - 4}{x - 2}$ کدام است؟\n۱) ۲\n۲) ۳\n۳) ۴\n۴) صفر\nپاسخ: گزینه ۳\nپاسخ تشریحی:\nبا تجزیه صورت کسر به صورت $(x-2)(x+2)$ و حذف عامل صفرشونده $(x-2)$، حاصل برابر $2+2=4$ خواهد بود.\nدرس: ریاضی تجربی | فصل: فصل سوم: حد بی‌نهایت و حد در بی‌نهایت | مبحث: درس ۳: رفع ابهام صفر صفرم (0/0) | پایه: جامع | رشته: تجربی | سختی: آسان | منبع: تالیفی";
  } else if (sub.includes("فیزیک")) {
    sample = "=== تست ۱ ===\nسوال: متحرکی روی خط راست با شتاب ثابت $a = 2 \\, m/s^2$ از حال سکون شروع به حرکت می‌کند. مسافت طی شده در ثانیه سوم چند متر است؟\n۱) ۳ متر\n۲) ۵ متر\n۳) ۷ متر\n۴) ۹ متر\nپاسخ: گزینه ۲\nپاسخ تشریحی:\nمسافت در ثانیه nام در حرکت با شتاب ثابت از حال سکون از رابطه $\\Delta x_n = \\frac{1}{2}a(2n - 1)$ به دست می‌آید. برای $n=3$: $\\Delta x_3 = \\frac{1}{2}(2)(2(3)-1) = 5 \\, m$.\nدرس: فیزیک تجربی | فصل: فصل ۱: حرکت بر خط راست | مبحث: بخش ۳: حرکت با شتاب ثابت | پایه: دوازدهم | رشته: تجربی | سختی: آسان | منبع: کنکور سراسری\n\n=== تست ۲ ===\nسوال: در مدار تک‌حلقه‌ای با نیروی محرکه $\\mathcal{E} = 12 \\, V$ و مقاومت درونی $r = 1 \\, \\Omega$ متصل به مقاومت خارجی $R = 5 \\, \\Omega$، جریان مدار چند آمپر است؟\n۱) ۱ آمپر\n۲) ۲ آمپر\n۳) ۳ آمپر\n۴) ۴ آمپر\nپاسخ: گزینه ۲\nپاسخ تشریحی:\nطبق قانون اهم برای کل مدار: $I = \\frac{\\mathcal{E}}{R + r} = \\frac{12}{5 + 1} = 2 \\, A$.\nدرس: فیزیک تجربی | فصل: فصل ۲: جریان الکتریکی | مبحث: بخش ۲: مدارهای تک‌حلقه جریان الکتریکی | پایه: یازدهم | رشته: تجربی | سختی: آسان | منبع: کنکور سراسری";
  } else if (sub.includes("شیمی")) {
