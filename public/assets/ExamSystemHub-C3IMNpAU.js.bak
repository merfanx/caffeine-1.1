      else if (k.includes("سختی") || k.includes("sakhti") || k.includes("difficulty")) taggedDiff = v;
      else if (k.includes("منبع") || k.includes("manba") || k.includes("source")) taggedSource = v;
      else if (k.includes("سال") || k.includes("year") || k.includes("sal")) taggedYear = v;
    }

    const metaLineMatch = chunk.match(/(?:^|\n)\s*(?:درس|فصل|مبحث|پایه|رشته|سختی|منبع|سال)\s*[:=][^\n]+/i);
    if (metaLineMatch) {
