 کربوهیدرات کمپلکس)"},{title:"آب کافی + دمنوش‌های آرام‌کننده:",desc:"حداقل ۸ لیوان آب در روز + دمنوش بابونه یا گل‌گاوزبان عصرگاهی"}]},nutritionBad:{items:["نوشابه و آبمیوه‌های صنعتی گازدار","شیرینی و قند زیاد و کیک‌های کارخانه‌ای","فست‌فود و غذاهای سرخ‌کرده خیلی چرب","کافئین بیش از حد و نوشابه‌های انرژی‌زا","پرخوری سنگین آخر شب قبل خواب"]},goldenBreakRules:{rules:[{title:"زمانش کوتاه باشه:",desc:"بین ۵ تا ۱۵ دقیقه (بیشترش باعث افت شدید تمرکز و خواب‌آلودگی میشه)"},{title:"بدون اسکرول بی‌هدف:",desc:"اینستاگرام، تلگرام، ریلز = دزد تمرکز! اگه بری سمت گوشی، مغزت استراحت نمی‌کنه، فقط خسته‌تر میشه."},{title:"حرکت کن و کشش بده:",desc:"یه کم راه برو، کشش بدن انجام بده، آب بخور. نشستن ممتد روی صندلی استراحت نیست!"},{title:"آب + اکسیژن خالص:",desc:"یه لیوان آب خنک بخور و چندتا نفس عمیق شکمی توی هوای آزاد یا کنار پنجره بکش."},{title:"ذهن رو کاملاً خالی کن:",desc:"به درس فکر نکن، فقط رها کن. حتی ۲ دقیقه سکوت و بستن چشم‌ها معجزه می‌کنه."},{title:"میان‌وعده سبک در صورت نیاز:",desc:"مغزها، یک عدد خرما یا یه میوه سبک (نه خوراکی‌های سنگین و چرب)"}],badBreakHabits:["خواب طولانی و سنگین وسط روز","چک کردن شبکه‌های اجتماعی و پاسخ به پیام‌ها","بحث و درگیری‌های فکری یا خانوادگی","شروع کار جدید یا درس جدید در حین دقایق استراحت"]},efficiencyTechniques:{tips:[{number:"۱",title:"با تمرکز مطلق شروع کن",desc:"اول هر پارت، گوشی رو از اتاق دور کن و فقط همون درس رو هدف‌دار بدون سردرگمی شروع کن."},{number:"۲",title:"پارت‌بندی استاندارد زمان",desc:"بهترین ریتم ۴۵ تا ۶۰ دقیقه مطالعه عمیق + ۱۰ تا ۱۵ دقیقه استراحت باکیفیت است."},{number:"۳",title:"فعال درس بخون، نه منفعل",desc:"فقط کتاب رو نگاه نکن! خلاصه‌نویسی کن، تست بزن، از خودت سوال بپرس و مفاهیم رو توضیح بده."},{number:"۴",title:"هدف هر پارت مشخص و شفاف باشه",desc:"مثلاً بگو: «این پارت فقط ۲۰ تست زیست گفتار ۳ می‌زنم»، نه اینکه هرچی شد پیش بره."},{number:"۵",title:"حذف ریشه‌ای حواس‌پرتی‌ها",desc:"گوشی، اعلان‌ها، شلوغی میز و محیط پر سر و صدا قاتلان اصلی تمرکز مغز هستند."},{number:"۶",title:"بدن آماده = مغز آماده",desc:"آب کافی بنوش، صاف بنشین، نور اتاق را تنظیم کن و اکسیژن کافی به ریه‌ها برسان."},{number:"۷",title:"استراحت درست بین پارت‌ها",desc:"نه گوشی و نه فیلم! فقط ریکاوری کوتاه و استراحت حسی برای آماده شدن مغز."}]}};function vS(l){if(typeof window>"u")return uw;const e=l?`caffeine_coffee_study_plan_${l}`:Am;try{const t=localStorage.getItem(e);if(t){const n=JSON.parse(t);if(n&&Array.isArray(n.days))return n}}catch(t){console.warn("[coffeePlanService] Failed reading coffee plan from localStorage:",t)}if(l&&e!==Am)try{const t=localStorage.getItem(Am);if(t){const n=JSON.parse(t);if(n&&Array.isArray(n.days))return{...n,id:`plan-${l}-${Date.now()}`,studentId:l}}}catch{}return uw}function dg(l){if(!(typeof window>"u"))try{const e={...l,updatedAt:new Date().toISOString()};l.studentId&&localStorage.setItem(`caffeine_coffee_study_plan_${l.studentId}`,JSON.stringify(e)),localStorage.setItem(Am,JSON.stringify(e)),window.dispatchEvent(new CustomEvent(yS,{detail:e}))}catch(e){console.error("[coffeePlanService] Failed saving coffee plan:",e)}}function wS(l,e){const t=l.group==="math"||e==="engineering_balance",n=l.advisorName||"دکتر علیرضا کاظمی";let i="لازم نیست بی‌نقص باشی؛ فقط متوقف نشو! 🌸",r="این هفته همه‌ی فکر و مشکلاتت رو الان خاموش کن و فقط روی یادگیری و بهتر شدن تک‌تک درس‌ها تمرکز کن. هدف این هفته اینه که با وجود مسئولیت، ذهنی و روحی روی درس بمونی. ♡",a=`${l.targetMajor||"رشته هدف"} (${l.targetUniversity||"دانشگاه برتر"}) ♡ Future ${t?"Engineer":"Doctor"}`;e==="engineering_balance"?(i="موفقیت یعنی مجموع تلاش‌های کوچکی که هر روز، بی سروصدا تکرار می‌شوند 📐",r="تمرکز این هفته روی درک عمیق شهودی حسابان و گسسته است. هر تست اشتباه، یک نکته طلایی برای کنکور اصلی است. با آرامش و دقت حل کن. ♡"):e==="recovery_boost"?(i="افت موقتی تراز، بهای تجربه است؛ مهم بازگشت هوشمندانه با انرژی مضاعف است! 🌱",r="در این دوره بازیابی، از مقایسه خودت با دیگران پرهیز کن. پارت‌های سبک‌تر ولی با تمرکز صددرصدی انتخاب شدند تا اعتمادبه‌نفس مطالعاتی‌ات بازسازی بشه. ♡"):e==="exam_prep"&&(i="آزمون فرصتی است برای کشف نقاط قابل بهبود، نه قضاوت درباره 