       __copyTextToClipboard=async(t)=>{if(!t||typeof t!="string")return!1;let ok=!1;if(typeof navigator<"u"&&navigator.clipboard&&typeof navigator.clipboard.writeText=="function"){try{await navigator.clipboard.writeText(t);ok=!0}catch(e){}}if(!ok&&typeof document<"u"){try{const el=document.createElement("textarea");el.value=t;el.style.position="fixed";el.style.top="0";el.style.left="0";el.style.width="2em";el.style.height="2em";el.style.padding="0";el.style.border="none";el.style.outline="none";el.style.boxShadow="none";el.style.background="transparent";el.style.opacity="0.01";el.setAttribute("readonly","");document.body.appendChild(el);el.focus();el.select();el.setSelectionRange(0,t.length);ok=document.execCommand("copy");document.body.removeChild(el)}catch(e2){}}return ok},__generatePrompt=(sub,grade,chapter,topic)=>{const sName=sub||"زیست‌شناسی",gName=(grade=="tenth"||grade=="10"||grade=="دهم")?"دهم":(grade=="eleventh"||grade=="11"||grade=="یازدهم")?"یازدهم":"دوازدهم",ch=chapter&&chapter!="all"&&chapter!="none"?chapter:"",tp=topic&&topic!="all"&&topic!="none"?topic:"";let sc="";if(ch||tp){sc=`\n### ⛔ محدوده مجاز و انحصاری دسته‌بندی سرفصل:\nشما «فقط و فقط» مجاز هستید سوالات را در محدوده زیر دسته‌بندی کنید:\n• درس: ${sName}\n• پایه: ${gName}\n${ch?`• فصل: ${ch}\n`:""}${tp?`• مبحث / گفتار: ${tp}\n`:""}\n⚠️ قانون الزامی یکپارچگی Taxonomy: از اختراع، تغییر یا ترجمه نام فصل و مبحث اکیداً خودداری کنید. نام فصل و مبحث باید دقیقاً مطابق کتاب درسی رسمی باشد.\n`}else{sc=`\n### محدوده درس: ${sName} (پایه ${gName})\nسوالات باید دقیقاً بر اساس سرفصل‌ها و گفتارهای رسمی کتاب درسی ${sName} دسته‌بندی شوند.\n`};return`### پرامپت اختصاصی استخراج، تحلیل و ورود سوالات ${sName} به بانک تست آکادمی کافئین\nشما سرگروه ارشد و متخصص دپارتمان ${sName} کنکور سراسری هستید. وظیفه شما استخراج، استانداردسازی و تفکیک دقیق سوالات چهارگزینه‌ای از متن ارسالی طبق فرمت استاندارد زیر است:\n${sc}\n### دستورالعمل استخراج و استانداردسازی سوالات:\n۱. هر تست را با جداکننده مشخص مانند === تست ۱ === یا --- تست ۱ --- از سایر تست‌ها جدا کن.\n۲. متن کامل صورت سوال را بعد از «سوال:» درج نما.\n۳. ۴ گزینه را به ترتیب با شماره‌های ۱) تا ۴) در خطوط مجزا بنویس.\n۴. شماره گزینه صحیح را با فرمت «پاسخ: گزینه ۲» مشخص کن.\n۵. تحلیل و پاسخ تشریحی جامع را بعد از «پاسخ تشریحی:» بنویس.\n۶. برچسب مشخصات سوال را با فرمت زیر در انتهای هر تست درج کن:\nدرس: ${sName} | فصل: ${ch||"نام دقیق فصل"} | مبحث: ${tp||"نام دقیق گفتار/مبحث"} | پایه: ${gName} | سختی: متوسط | منبع: کنکور سراسری\n۷. فرمول‌های ریاضی، فیزیک و واکنش‌های شیمیایی را حتماً در نماد لاتک ($...$) قرار بده.\n\n### نمونه خروجی استاندارد برای هر تست:\n=== تست ۱ ===\nسوال: در فرایند ترجمه در سلول یوکاریوتی، کدام مورد پیش از ورود کدون آغاز به جایگاه P ریبوزوم رخ می‌دهد؟\n۱) اتصال زیرواحد بزرگ ریبوزوم به زیرواحد کوچک\n۲) قرارگیری اولین tRNA حامل متیونین در جایگاه P\n۳) شناسایی توالی آغاز توسط زیرواحد کوچک ریبوزوم\n۴) تشکیل پیوند پپتیدی میان اولین و دومین آمینواسید\nپاسخ: گزینه ۳\nپاسخ تشریحی:\nدر آغاز ترجمه، ابتدا زیرواحد کوچک ریبوزوم همراه با فاکتورهای آغازگر، توالی راهنما در ابتدای mRNA را شناسایی می‌کند؛ سپس tRNA آغازین به کدون آغاز متصل شده و در نهایت زیرواحد بزرگ ملحق می‌شود.\nدرس: ${sName} | فصل: ${ch||"فصل ۲: جریان اطلاعات در یاخته"} | مبحث: ${tp||"گفتار ۱: رونویسی و ترجمه"} | پایه: ${gName} | سختی: متوسط | منبع: کنکور سراسری`},me=async(forcePrompt)=>{try{const isDirect=typeof forcePrompt=="string"&&forcePrompt.trim().length>30,sub=x.subject||"زیست‌شناسی",curGrade=x.promptGrade||x.grade||"دوازدهم",curCh=x.chapter||"",curTopic=x.topic||"";let pText="";if(isDirect){pText=forcePrompt.trim()}else{pText=__generatePrompt(sub,curGrade,curCh,curTopic);try{const payload={subject:sub,grade:curGrade,field:x.group||"تجربی",chapters:(x.selectedChapters&&x.selectedChapters.length>0)?x.selectedChapters:(curCh?[curCh]:void 0),lessons:(x.selectedLessons&&x.selectedLessons.length>0)?x.selectedLessons:(curTopic?[curTopic]:void 0)};fetch("/api/v1/ai/subject-prompt",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload